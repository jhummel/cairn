#!/usr/bin/env bash
set -euo pipefail

RALPH_VERSION="0.1.0"

# ── Portable self-location (works with symlinks on macOS) ────────────
resolve_path() {
    local target="$1"
    while [ -L "$target" ]; do
        local dir
        dir="$(cd "$(dirname "$target")" && pwd)"
        target="$(readlink "$target")"
        [[ "$target" != /* ]] && target="$dir/$target"
    done
    echo "$(cd "$(dirname "$target")" && pwd)/$(basename "$target")"
}

RALPH_BIN="$(resolve_path "$0")"
RALPH_ROOT="$(cd "$(dirname "$RALPH_BIN")/.." && pwd)"
export RALPH_LIB_DIR="$RALPH_ROOT/lib"

# Venv Python for narration scripts (kokoro, sounddevice, anthropic)
export RALPH_NARRATE_PYTHON="$RALPH_ROOT/.venv/bin/python3"

# ── Project root detection ───────────────────────────────────────────
find_project_root() {
    # 1. Env var (already set externally)
    if [[ -n "${RALPH_PROJECT_ROOT:-}" ]]; then
        echo "$RALPH_PROJECT_ROOT"
        return
    fi

    # 2. Walk upward from CWD looking for .ralph/ directory
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -d "$dir/.ralph" ]]; then
            echo "$dir"
            return
        fi
        dir="$(dirname "$dir")"
    done

    # 3. Git root
    local git_root
    if git_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
        echo "$git_root"
        return
    fi

    # 4. CWD
    echo "$PWD"
}

# ── Parse global flags ───────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
        --project-root)
            export RALPH_PROJECT_ROOT="$2"
            shift 2
            ;;
        --project-root=*)
            export RALPH_PROJECT_ROOT="${1#*=}"
            shift
            ;;
        --version|-v)
            echo "ralph $RALPH_VERSION"
            exit 0
            ;;
        --help|-h)
            # Fall through to help below
            set -- "help"
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            echo "Run 'ralph help' for usage" >&2
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

# ── Resolve project root and data directory ──────────────────────────
export RALPH_PROJECT_ROOT="$(find_project_root)"
export RALPH_DATA_DIR="$RALPH_PROJECT_ROOT/.ralph"

# ── Source shared utilities and config ───────────────────────────────
source "$RALPH_LIB_DIR/ralph_common.sh"
source "$RALPH_LIB_DIR/ralph_config.sh"

# ── Subcommand dispatch ──────────────────────────────────────────────
SUBCOMMAND="${1:-help}"
shift || true

case "$SUBCOMMAND" in
    plan)
        exec "$RALPH_LIB_DIR/ralph_plan.sh" "$@"
        ;;
    run)
        exec "$RALPH_LIB_DIR/ralph_loop.sh" "$@"
        ;;
    summarize)
        exec "$RALPH_LIB_DIR/ralph_summarize.sh" "$@"
        ;;
    narrate)
        NARRATE_SOCKET="/tmp/ralph-tts.sock"
        NARRATE_PID_FILE="/tmp/ralph-tts.pid"
        NARRATE_ACTION="${1:-}"

        if [[ ! -x "$RALPH_NARRATE_PYTHON" ]]; then
            echo "ERROR: Narration venv not found at $RALPH_NARRATE_PYTHON" >&2
            echo "Run: python3.11 -m venv $RALPH_ROOT/.venv && $RALPH_ROOT/.venv/bin/pip install kokoro sounddevice anthropic" >&2
            exit 1
        fi

        case "$NARRATE_ACTION" in
            on|start)
                if [[ -f "$NARRATE_PID_FILE" ]] && kill -0 "$(cat "$NARRATE_PID_FILE")" 2>/dev/null; then
                    echo "Narration server already running (PID: $(cat "$NARRATE_PID_FILE"))"
                    exit 0
                fi
                echo "Starting narration server (voice: ${RALPH_NARRATION_VOICE:-bf_emma})..."
                "$RALPH_NARRATE_PYTHON" "$RALPH_LIB_DIR/ralph_narrate_server.py" \
                    --voice "${RALPH_NARRATION_VOICE:-bf_emma}" \
                    --socket "$NARRATE_SOCKET" &
                NARRATE_PID=$!
                echo "$NARRATE_PID" > "$NARRATE_PID_FILE"
                disown "$NARRATE_PID"
                sleep 1
                if kill -0 "$NARRATE_PID" 2>/dev/null; then
                    echo "Narration server started (PID: $NARRATE_PID)"
                    echo "Socket: $NARRATE_SOCKET"
                else
                    echo "ERROR: Narration server failed to start" >&2
                    rm -f "$NARRATE_PID_FILE"
                    exit 1
                fi
                ;;
            off|stop)
                if [[ -f "$NARRATE_PID_FILE" ]]; then
                    PID=$(cat "$NARRATE_PID_FILE")
                    if kill -0 "$PID" 2>/dev/null; then
                        kill "$PID" 2>/dev/null
                        echo "Narration server stopped (PID: $PID)"
                    else
                        echo "Narration server was not running"
                    fi
                    rm -f "$NARRATE_PID_FILE"
                else
                    echo "Narration server is not running"
                fi
                rm -f "$NARRATE_SOCKET"
                ;;
            status)
                if [[ -f "$NARRATE_PID_FILE" ]] && kill -0 "$(cat "$NARRATE_PID_FILE")" 2>/dev/null; then
                    echo "Narration server: running (PID: $(cat "$NARRATE_PID_FILE"))"
                    echo "Socket: $NARRATE_SOCKET"
                else
                    echo "Narration server: stopped"
                    rm -f "$NARRATE_PID_FILE"
                fi
                ;;
            "")
                echo "Usage: ralph narrate <on|off|status|\"text\">" >&2
                exit 1
                ;;
            *)
                # Treat everything else as text to speak directly
                TEXT="$NARRATE_ACTION"
                shift || true
                if [[ $# -gt 0 ]]; then
                    TEXT="$TEXT $*"
                fi
                exec "$RALPH_NARRATE_PYTHON" "$RALPH_LIB_DIR/ralph_narrate.py" "$TEXT"
                ;;
        esac
        ;;
    init)
        source "$RALPH_LIB_DIR/ralph_init.sh"
        ;;
    status)
        TASKS_FILE="$RALPH_DATA_DIR/tasks.json"
        COMPLETED_FILE="$RALPH_DATA_DIR/tasks.completed.json"

        echo ""
        echo "Project: $(basename "$RALPH_PROJECT_ROOT")"
        echo "Root:    $RALPH_PROJECT_ROOT"
        echo ""

        if [[ ! -d "$RALPH_DATA_DIR" ]]; then
            echo "Not initialized. Run 'ralph init' first."
            exit 0
        fi

        if [[ -f "$COMPLETED_FILE" ]]; then
            python3 - "$COMPLETED_FILE" <<'PYEOF'
import json, sys
with open(sys.argv[1]) as f:
    data = json.load(f)
tasks = data.get('tasks', [])
if tasks:
    print(f'  Previously completed: {len(tasks)} task(s)')
PYEOF
        fi

        if [[ -f "$TASKS_FILE" ]]; then
            python3 - "$TASKS_FILE" <<'PYEOF'
import json, sys
with open(sys.argv[1]) as f:
    data = json.load(f)
tasks = data.get('tasks', [])
if not tasks:
    print("  No pending tasks.")
    sys.exit(0)
counts = {}
for t in tasks:
    s = t['status']
    counts[s] = counts.get(s, 0) + 1
parts = [f'{v} {k}' for k, v in sorted(counts.items())]
print(f'  Status: {", ".join(parts)} ({len(tasks)} total)')
print()
for t in tasks:
    dep_str = f' (depends on: {t["dependencies"]})' if t.get('dependencies') else ''
    dir_str = f' [{t["directory"]}]' if t.get('directory') else ''
    status_icon = {'complete': '✓', 'in-progress': '▶', 'pending': '○', 'blocked': '✗'}
    icon = status_icon.get(t['status'], '?')
    print(f'  {icon} #{t["id"]} [P{t["priority"]}]{dir_str} {t["title"]}{dep_str}')
PYEOF
        else
            echo "  No tasks.json found. Run 'ralph plan' to create one."
        fi
        echo ""
        ;;
    edit)
        target="${1:-tasks}"
        case "$target" in
            tasks)
                file="$RALPH_DATA_DIR/tasks.json"
                ;;
            plan|notes)
                file="$RALPH_DATA_DIR/planning-notes.md"
                ;;
            config)
                file="$RALPH_PROJECT_ROOT/ralph.json"
                ;;
            *)
                echo "Unknown target: $target" >&2
                echo "Usage: ralph edit [tasks|plan|config]" >&2
                exit 1
                ;;
        esac
        if [[ ! -f "$file" ]]; then
            echo "File not found: $file" >&2
            exit 1
        fi
        ${EDITOR:-vi} "$file"
        ;;
    logs)
        LOG_FILE="$RALPH_DATA_DIR/.ralph_iterations.log"
        if [[ ! -f "$LOG_FILE" ]]; then
            echo "No iteration log found."
            exit 0
        fi
        cat "$LOG_FILE"
        ;;
    help)
        cat <<'HELP'
Ralph — Agentic Task Orchestration for Claude Code

Usage: ralph <command> [options]

Commands:
  plan              Interactive planning + task generation
  run [max]         Execute pending tasks (default: 30 iterations)
  summarize         Update IMPLEMENTATION.md with current system state
  init              Initialize .ralph/ directory and starter config
  status            Show current task list overview
  edit [target]     Edit tasks.json (default), planning notes, or config
                    Targets: tasks, plan, config
  logs              Show iteration log
  narrate on        Start the TTS narration server (background daemon)
  narrate off       Stop the narration server
  narrate status    Check if the narration server is running
  narrate "text"    Speak text directly via Kokoro TTS

Options:
  --project-root <path>   Override project root detection
  --version, -v           Show version
  --help, -h              Show this message

Project Root Detection (in order):
  1. --project-root flag or RALPH_PROJECT_ROOT env var
  2. Walk upward from CWD looking for .ralph/ directory
  3. Git repository root
  4. Current working directory

Configuration:
  Optional ralph.json at project root. Run 'ralph init' for a starter config.

Getting Started:
  cd your-project
  ralph init          # Create .ralph/ and ralph.json
  ralph plan          # Plan what to build
  ralph run           # Execute the plan
  ralph summarize     # Update architecture docs
HELP
        ;;
    *)
        echo "Unknown command: $SUBCOMMAND" >&2
        echo "Run 'ralph help' for usage" >&2
        exit 1
        ;;
esac
